# Copy to .env to change a value. Every variable has a working default.

# Docker Compose (docker-compose.yml)
# Host port of the application: the interface, and /api through the gateway.
APP_PORT=8080
# Where the gateway finds the backend: the port ../backend publishes on the host.
BACKEND_URL=http://host.docker.internal:8081

# Development server (npm run dev)
# `next dev` proxies /api to this address.
API_PROXY_TARGET=http://localhost:8081
