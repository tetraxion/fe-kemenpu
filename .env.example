# Copy to .env to change a value. Every variable has a working default.

# Development server (npm run dev)
# `next dev` proxies /api to this address. In containers the gateway does that.
API_PROXY_TARGET=http://localhost:8080

# Docker Compose in this folder (docker-compose.override.yml)
# Host port when the frontend is started on its own.
FRONTEND_PORT=3000
